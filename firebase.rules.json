{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "hostUid": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || data.val() == auth.uid)"
        },
        "public": {
          ".read": "auth != null && root.child('rooms').child($room).child('hostUid').exists()",
          ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid"
        },
        "players": {
          ".read": "auth != null && root.child('rooms').child($room).child('hostUid').exists()",
          "$uid": {
            "name": { ".write": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid)" },
            "connected": { ".write": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid)" },
            "joinedAt": { ".write": "auth != null && (root.child('rooms').child($room).child('hostUid').val() == auth.uid || (auth.uid == $uid && !data.exists()))" },
            "alive": { ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid" },
            "assigned": { ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid" },
            "eliminatedBy": { ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid" },
            "eliminatedAt": { ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid" }
          }
        },
        "private": {
          ".read": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid)",
            ".write": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid"
          }
        },
        "actions": {
          "$night": {
            "$phase": {
              ".read": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid",
              "$uid": {
                ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid)",
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          }
        },
        "votes": {
          "$voteId": {
            "$uid": {
              ".read": "auth != null && (auth.uid == $uid || (root.child('rooms').child($room).child('hostUid').val() == auth.uid && (root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'vote_reveal' || root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'defense' || root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'vote_result')))",
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'vote' && root.child('rooms').child($room).child('public').child('phase').child('voteId').val() == $voteId"
            }
          }
        },
        "voteReceipts": {
          "$voteId": {
            ".read": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.val() == true && root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'vote' && root.child('rooms').child($room).child('public').child('phase').child('voteId').val() == $voteId"
            }
          }
        },
        "confirmVotes": {
          "$confirmId": {
            "$uid": {
              ".read": "auth != null && (auth.uid == $uid || (root.child('rooms').child($room).child('hostUid').val() == auth.uid && (root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'confirm_reveal' || root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'confirm_result')))",
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'confirm_vote' && root.child('rooms').child($room).child('public').child('phase').child('confirmId').val() == $confirmId && (newData.child('choice').val() == 'eliminate' || newData.child('choice').val() == 'pardon')"
            }
          }
        },
        "confirmReceipts": {
          "$confirmId": {
            ".read": "auth != null && root.child('rooms').child($room).child('hostUid').val() == auth.uid",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.val() == true && root.child('rooms').child($room).child('public').child('phase').child('state').val() == 'confirm_vote' && root.child('rooms').child($room).child('public').child('phase').child('confirmId').val() == $confirmId"
            }
          }
        }
      }
    }
  }
}